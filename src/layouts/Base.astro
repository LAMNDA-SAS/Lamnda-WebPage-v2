---
/* Base layout: SEO shell + theme anti-FOUC + global chrome. */
import "../styles/tokens.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: string;
}

const { title, description, canonical, ogImage, lang = "es" } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site);
const socialImage = new URL(ogImage ?? `${baseUrl}hero-poster-dark.webp`, site);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="theme-color" content="#0A1628" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}favicon-16.png`} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />
    <link
      rel="preload"
      as="image"
      href={`${baseUrl}hero-poster-dark.webp`}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={`${baseUrl}hero-poster-light.webp`}
      fetchpriority="high"
      media="(prefers-color-scheme: light)"
    />
    <script is:inline>
      // Anti-FOUC: apply stored theme before first paint; spec default is dark.
      try {
        var stored = localStorage.getItem("lamnda-theme");
        var theme = stored === "light" || stored === "dark" ? stored : "dark";
        document.documentElement.setAttribute("data-theme", theme);
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
    <noscript>
      <style>
        /* No-JS fallback: reveal-hidden sections must stay visible. */
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <style is:inline>
      html:not([data-theme]) {
        background: #0a1628;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <script is:inline>
      // Theme toggle wiring (progressive enhancement; works with data-theme).
      (function () {
        function current() {
          return (
            document.documentElement.getAttribute("data-theme") || "dark"
          );
        }
        function apply(t) {
          document.documentElement.setAttribute("data-theme", t);
          try {
            localStorage.setItem("lamnda-theme", t);
          } catch (e) {}
          document
            .querySelectorAll("[data-theme-toggle]")
            .forEach(function (btn) {
              btn.setAttribute("aria-pressed", String(t === "light"));
              var label = btn.querySelector("[data-theme-label]");
              if (label) label.textContent = t === "light" ? "Claro" : "Oscuro";
            });
        }
        document.addEventListener("click", function (ev) {
          var el = ev.target && ev.target.closest
            ? ev.target.closest("[data-theme-toggle]")
            : null;
          if (!el) return;
          apply(current() === "dark" ? "light" : "dark");
        });
        apply(current());
      })();
    </script>
    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--primary-text);
        /* AA: dark #0A1628 on #7AB3FF = 8.39:1 (white-on-#7AB3FF was 2.16:1 FAIL) */
        color: #0a1628;
        padding: 0.6rem 1rem;
        z-index: 100;
        border-radius: 0 0 8px 0;
      }
      html[data-theme="light"] .skip-link {
        color: #fff;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
