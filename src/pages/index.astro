---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HopfHero from "../components/HopfHero.astro";
import { getCollection } from "astro:content";

/* EN exception: do not translate */
const HERO_HEADLINE = "Complex problems. Elegant solutions.";
const heroSplit = HERO_HEADLINE.indexOf("Elegant");
const HERO_LINE1 = HERO_HEADLINE.slice(0, heroSplit).trim();
const HERO_LINE2 = HERO_HEADLINE.slice(heroSplit).trim();

const services = (await getCollection("services")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const pillars = await getCollection("pillars");
const vision = (await getCollection("vision"))[0];
const mission = (await getCollection("mission"))[0];

const fullCards = services.filter((s) => s.data.card === "full");
const summaryCards = services.filter((s) => s.data.card === "summary");

const pillarOrder = ["data", "security", "automation"] as const;
const orderedPillars = [...pillars].sort(
  (a, b) => pillarOrder.indexOf(a.data.key as (typeof pillarOrder)[number]) - pillarOrder.indexOf(b.data.key as (typeof pillarOrder)[number]),
);

const pillarLabel: Record<string, string> = {
  data: "Data Science",
  security: "Cybersecurity",
  automation: "Automations",
};

const title = "Lamnda — Ciencia, tecnología e impacto";
const description =
  "Lamnda SAS: notificaciones inteligentes, documentación automatizada, lead scoring y dashboards dinámicos. Ciencia x tecnología x impacto.";
---

<Base title={title} description={description}>
  <Header />
  <main id="main">
    <!-- HERO / LOBBY: full-bleed WebGL canvas, copy overlaid left -->
    <section id="top" class="hero hero-overlay" aria-labelledby="hero-heading">
      <div class="hero-bg" aria-hidden="false">
        <HopfHero />
      </div>
      {/* EN exception: equations stay in English (math notation) */}
      <aside class="hero-equations" aria-label="Hopf fibration equations">
        <p class="eq-title">Hopf Fibration</p>
        <p class="eq-line">Hopf Fibration — S3→S2 mapping</p>
        <p class="eq-line">(z1,z2) = (cos(θ/2)·e^(it), sin(θ/2)·e^(i(t+φ)))</p>
        <p class="eq-line">d = 1 − b·sin(t+φ)</p>
      </aside>
      <div class="wrap hero-copy-layer">
        <div class="hero-copy" data-hero-copy>
          <p class="hero-eyebrow">DATA / SECURITY / AUTOMATION</p>
          {/* EN exception: do not translate */}
          <h1 id="hero-heading"><span class="h1-line1">{HERO_LINE1}</span>{" "}<span class="h1-line2">{HERO_LINE2}</span></h1>
          <p class="lede">
            Convertimos sistemas complejos en productos claros: datos,
            seguridad y automatización con rigor científico.
          </p>
          <div class="hero-ctas">
            <a class="cta-primary" href="#services" id="hero-cta" data-magnetic>
              Explore our solutions <span aria-hidden="true">→</span>
            </a>
            <a class="cta-ghost" href="#contact" data-magnetic>Get in touch</a>
          </div>
          <p class="hero-note">
            Campo de fibras de Hopf — cada hilo es un flujo de tu operación,
            entrelazado sin enredarse.
          </p>
          {/* Qualitative proof line: no numeric claims. */}
          <p class="hero-proof">
            Equipos que responden en minutos, documentos listos el mismo día,
            agendas que se llenan solas.
          </p>
        </div>
        <div class="hero-pillars" aria-label="Pilares destacados">
          {
            orderedPillars.map((p) => (
              <div class="hero-pillar" data-hero-pillar={p.data.key}>
                {p.data.key === "data" && (
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 13V7M6 13V3M10 13v-6M14 13V5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                )}
                {p.data.key === "security" && (
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 1.5 13 3.5v4c0 3.2-2.1 5.4-5 7-2.9-1.6-5-3.8-5-7v-4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                )}
                {p.data.key === "automation" && (
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8a5 5 0 0 1 8.7-3.4M13 8a5 5 0 0 1-8.7 3.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11.5 1.8v2.6h-2.6M4.5 14.2v-2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
                <div class="hero-pillar-copy">
                  <strong>{p.data.title}</strong>
                  <span>{p.data.tagline}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <p class="hero-tag" aria-hidden="true">HOPF FIELD · 36 FIBERS · LIVE</p>
    </section>

    <!-- PILLARS -->
    <section id="pillars" class="section" aria-labelledby="pillars-heading" data-reveal>
      <div class="wrap">
        <h2 id="pillars-heading" tabindex="-1">Pilares</h2>
        <div class="pillar-grid">
          {
            orderedPillars.map((p) => (
              <article class="pillar-card" data-pillar={p.data.key}>
                <h3>{p.data.title}</h3>
                <p>{p.data.tagline}</p>
                {/* Qualitative practice line per pillar; security stays a practice, not a product claim. */}
                {p.data.key === "data" && (
                  <p class="pillar-proof">
                    Del historial disperso a la lista priorizada: cada lead llega con contexto.
                  </p>
                )}
                {p.data.key === "automation" && (
                  <p class="pillar-proof">
                    Lo repetitivo se hace solo; tu equipo solo decide lo importante.
                  </p>
                )}
                {p.data.key === "security" && (
                  <p class="pillar-proof">
                    Trazabilidad y revisión humana en cada flujo automatizado.
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="section" aria-labelledby="services-heading" data-reveal>
      <div class="wrap">
        <h2 id="services-heading" tabindex="-1">Soluciones</h2>
        <p class="section-lede">
          Cinco soluciones prioritarias a fondo, tres capacidades resumidas.
          Elige por dónde empezar.
        </p>
        <div class="card-grid">
          {
            fullCards.map((s) => (
              <article class="card card-full" data-card={s.slug}>
                <p class="pillar-tag">{pillarLabel[s.data.pillar]}</p>
                <span class="icon-box" aria-hidden="true">
                  {s.data.pillar === "data" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M2 13V7M6 13V3M10 13v-6M14 13V5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  )}
                  {s.data.pillar === "security" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M8 1.5 13 3.5v4c0 3.2-2.1 5.4-5 7-2.9-1.6-5-3.8-5-7v-4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                  )}
                  {s.data.pillar === "automation" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M3 8a5 5 0 0 1 8.7-3.4M13 8a5 5 0 0 1-8.7 3.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11.5 1.8v2.6h-2.6M4.5 14.2v-2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                </span>
                <h3>{s.data.title}</h3>
                {/* DRAFT badge: rendered only when frontmatter sets draftLabel. */}
                {s.data.draftLabel && <p class="draft-badge">{s.data.draftLabel}</p>}
                <p class="card-summary-text">{s.data.summary}</p>
                <ul>
                  {s.data.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                {/* Qualitative outcome line: rendered only when frontmatter sets outcome. */}
                {s.data.outcome && <p class="card-outcome">{s.data.outcome}</p>}
                <a class="example-hint" href={`/servicios/${s.slug}`}>Ver ejemplo en vivo <span class="arrow-chip" aria-hidden="true">→</span></a>
                {s.slug === "dashboards-dinamicos" && (
                  <div
                    class="dashboard-mock"
                    role="img"
                    aria-label="Mock ilustrativo de dashboard (sin datos reales)"
                  >
                    <svg viewBox="0 0 320 180" width="100%" height="auto" aria-hidden="true">
                      <rect x="0" y="0" width="320" height="180" rx="12" fill="var(--surface)" />
                      <rect x="16" y="16" width="120" height="14" rx="7" fill="var(--primary)" opacity="0.8" />
                      <rect x="16" y="40" width="88" height="10" rx="5" fill="var(--muted)" opacity="0.6" />
                      <rect x="16" y="60" width="86" height="96" rx="8" fill="none" stroke="var(--primary)" stroke-width="2" />
                      <polyline
                        points="20,140 50,120 80,128 110,96 140,104 170,80 200,88"
                        fill="none"
                        stroke="var(--primary)"
                        stroke-width="3"
                        stroke-linecap="round"
                      />
                      {[0, 1, 2].map((i) => (
                        <rect x={120 + i * 62} y={60 + i * 12} width="52" height="34" rx="6" fill="var(--surface)" stroke="var(--border)" />
                      ))}
                      <circle cx="260" cy="130" r="22" fill="none" stroke="var(--primary)" stroke-width="6" stroke-dasharray="90 60" />
                    </svg>
                    <p class="mock-caption">Mock ilustrativo — sin datos reales</p>
                  </div>
                )}
              </article>
            ))
          }
        </div>
        <div class="card-grid summary">
          {
            summaryCards.map((s) => (
              <article class="card card-summary" data-card={s.slug}>
                <p class="pillar-tag">{pillarLabel[s.data.pillar]}</p>
                <span class="icon-box" aria-hidden="true">
                  {s.data.pillar === "data" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M2 13V7M6 13V3M10 13v-6M14 13V5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  )}
                  {s.data.pillar === "security" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M8 1.5 13 3.5v4c0 3.2-2.1 5.4-5 7-2.9-1.6-5-3.8-5-7v-4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                  )}
                  {s.data.pillar === "automation" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M3 8a5 5 0 0 1 8.7-3.4M13 8a5 5 0 0 1-8.7 3.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11.5 1.8v2.6h-2.6M4.5 14.2v-2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                </span>
                <h3>{s.data.title}</h3>
                <p class="card-summary-text">{s.data.summary}</p>
                <a class="example-hint" href={`/servicios/${s.slug}`}>Ver ejemplo en vivo <span class="arrow-chip" aria-hidden="true">→</span></a>
              </article>
            ))
          }
        </div>
        {/* Static showcase strip: CSS-only mocks + integration chips, no JS or external assets. */}
        <div id="showcase" aria-label="Cómo se ve">
          <h3 class="showcase-title">Cómo se ve</h3>
          <div class="showcase-grid">
            <figure
              class="showcase-mock"
              role="img"
              aria-label="Mock ilustrativo de fila de notificación priorizada"
            >
              <div class="mock-row" aria-hidden="true">
                <span class="mock-dot"></span>
                <span class="mock-lines"><i></i><i></i></span>
                <span class="mock-tag">WhatsApp</span>
              </div>
              <figcaption>Mock ilustrativo</figcaption>
            </figure>
            <figure
              class="showcase-mock"
              role="img"
              aria-label="Mock ilustrativo de barras de prioridad de prospectos"
            >
              <div class="mock-bars" aria-hidden="true">
                <div class="mock-bar"><span>Alta</span><i style="width: 82%"></i></div>
                <div class="mock-bar"><span>Media</span><i style="width: 55%"></i></div>
                <div class="mock-bar"><span>Baja</span><i style="width: 28%"></i></div>
              </div>
              <figcaption>Mock ilustrativo</figcaption>
            </figure>
            <figure
              class="showcase-mock"
              role="img"
              aria-label="Mock ilustrativo de tarjeta de agenda automática"
            >
              <div class="mock-schedule" aria-hidden="true">
                <strong>Agenda de mañana</strong>
                <div class="mock-chips">
                  <span>09:00</span><span>11:30</span><span>16:00</span>
                </div>
              </div>
              <figcaption>Mock ilustrativo</figcaption>
            </figure>
          </div>
          <p class="showcase-note">Mock ilustrativo — sin datos reales</p>
          <p class="showcase-connect">Se conecta con</p>
          <ul class="showcase-chips" aria-label="Integraciones">
            <li>
              {/* Original abstract mark: speech bubble, not the vendor logo. */}
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 3.5h12v7H8l-3.5 3v-3H2Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              <span>WhatsApp</span>
            </li>
            <li>
              {/* Original abstract mark: envelope motif, not the vendor logo. */}
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m3 5 5 4 5-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span>Gmail</span>
            </li>
            <li>
              {/* Original abstract mark: channel bars, not the vendor logo. */}
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2.5 6.5h11M2.5 10h11M5 3v10M11 3v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span>Slack</span>
            </li>
            <li>
              {/* Original abstract mark: hub nodes, not the vendor logo. */}
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="3" cy="3.5" r="1.4" fill="currentColor"/><circle cx="13" cy="3.5" r="1.4" fill="currentColor"/><circle cx="3" cy="12.5" r="1.4" fill="currentColor"/><circle cx="13" cy="12.5" r="1.4" fill="currentColor"/><path d="M4 4.5 6.5 6.5M12 4.5 9.5 6.5M4 11.5l2.5-2M12 11.5 9.5 9.5" stroke="currentColor" stroke-width="1.2"/></svg>
              <span>HubSpot</span>
            </li>
          </ul>
        </div>
        <div class="ally-block">
          <h3>Tu aliado en la transformación digital</h3>
          <p>
            Empezamos por un caso de uso acotado, medimos impacto y luego
            escalamos. Sin big-bang, sin humo.
          </p>
          <div class="ally-actions">
            <a class="cta-primary" href="#contact" data-magnetic>Solicita una demo</a>
            <a class="cta-ghost" href="#services">Ver cómo se ve</a>
          </div>
        </div>
      </div>
    </section>

    <!-- VISION / MISSION -->
    <section id="vision" class="section" aria-labelledby="vision-heading" data-reveal>
      <div class="wrap vm-grid">
        <article class="vm-card">
          <h2 id="vision-heading">{vision?.data.title ?? "Visión"}</h2>
          <p class="tbd-label">TBD — texto oficial pendiente</p>
          <div class="vm-body">
            {vision ? <p>{vision.body}</p> : <p>Contenido pendiente (TBD).</p>}
          </div>
        </article>
        <article class="vm-card">
          <h2 id="mission-heading">{mission?.data.title ?? "Misión"}</h2>
          <p class="tbd-label">TBD — texto oficial pendiente</p>
          <div class="vm-body">
            {mission ? <p>{mission.body}</p> : <p>Contenido pendiente (TBD).</p>}
          </div>
        </article>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section" aria-labelledby="contact-heading" data-reveal>
      <div class="wrap contact-wrap">
        <h2 id="contact-heading" tabindex="-1">Contacto</h2>
        <p>
          Cuéntanos tu caso: respondemos en menos de 48 horas hábiles.
        </p>
        <ul class="contact-list">
          <li><a href="mailto:hola@lamnda.example.com">hola@lamnda.example.com</a></li>
          <li><a href="#top">Volver al inicio</a></li>
        </ul>
        <form class="contact-form" action="mailto:hola@lamnda.example.com" method="post" enctype="text/plain">
          <label>Nombre<input type="text" name="nombre" required autocomplete="name" /></label>
          <label>Correo<input type="email" name="correo" required autocomplete="email" /></label>
          <label>Mensaje<textarea name="mensaje" rows="4" required></textarea></label>
          <button type="submit">Enviar</button>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 0.9rem;
  }
  .hero {
    padding: 3.5rem 0 2.5rem;
  }
  .hero-overlay {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 5rem 0 4rem;
    overflow: clip;
    background: var(--bg);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg::after {
    /* Left scrim keeps overlaid copy legible over the fibers. */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--hero-scrim-strong) 0%,
      var(--hero-scrim-mid) 34%,
      var(--hero-scrim-soft) 62%,
      transparent 78%
    );
    pointer-events: none;
  }
  .hero-copy-layer {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-copy {
    max-width: 32rem;
    will-change: transform, opacity;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    line-height: 1.08;
    margin: 0 0 1rem;
  }
  .lede {
    font-size: 1.12rem;
    color: var(--muted);
    max-width: 34rem;
  }
  .hero-ctas {
    display: flex;
    gap: 0.8rem;
    margin: 1.4rem 0;
    flex-wrap: wrap;
  }
  .cta-primary {
    background: var(--primary-text);
    /* AA: dark #0A1628 on #7AB3FF = 8.39:1 (white-on-#7AB3FF was 2.16:1 FAIL) */
    color: #0a1628;
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
  }
  html[data-theme="light"] .cta-primary {
    color: #fff;
  }
  .cta-ghost {
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
  }
  .hero-note {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 30rem;
  }
  .section {
    padding: 3rem 0 1rem;
  }
  .section h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin: 0 0 0.6rem;
  }
  .section-lede {
    color: var(--muted);
    max-width: 44rem;
  }
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .pillar-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem;
  }
  .pillar-card h3 {
    margin: 0 0 0.4rem;
  }
  .pillar-card p {
    margin: 0;
    color: var(--muted);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .card-grid.summary {
    grid-template-columns: repeat(3, 1fr);
  }
  #services .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.7rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  #services .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--primary-text);
  }
  #services .icon-box {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--primary-text);
    flex: none;
  }
  .pillar-tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary-text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    margin: 0;
  }
  #services .card h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  #services .card-summary-text {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }
  #services .card ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    display: grid;
    gap: 0.4rem;
  }
  .dashboard-mock {
    margin-top: 1rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    padding: 0.7rem;
  }
  .mock-caption {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0.4rem 0 0;
  }
  /* New v7 rows: DRAFT badge shares the TBD visual language. */
  .draft-badge {
    display: inline-block;
    font-size: 0.78rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
    margin: 0.8rem 0 0;
  }
  #services .card-outcome {
    margin: 0;
    color: var(--text);
    font-weight: 600;
