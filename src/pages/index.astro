---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HopfHero from "../components/HopfHero.astro";
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;

/* EN exception: do not translate */
const HERO_HEADLINE = "Complex problems. Elegant solutions.";
const heroSplit = HERO_HEADLINE.indexOf("Elegant");
const HERO_LINE1 = HERO_HEADLINE.slice(0, heroSplit).trim();
const HERO_LINE2 = HERO_HEADLINE.slice(heroSplit).trim();

const services = (await getCollection("services")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const pillars = await getCollection("pillars");
const vision = (await getCollection("vision"))[0];
const mission = (await getCollection("mission"))[0];

const pillarOrder = ["data", "automation"] as const;
const orderedPillars = [...pillars].sort(
  (a, b) => pillarOrder.indexOf(a.data.key as (typeof pillarOrder)[number]) - pillarOrder.indexOf(b.data.key as (typeof pillarOrder)[number]),
);

const pillarLabel: Record<string, string> = {
  data: "Data Science",
  automation: "Automations",
};

const title = "Lamnda — Ciencia, tecnología e impacto";
const description =
  "Lamnda SAS: notificaciones inteligentes, documentación automatizada, lead scoring y dashboards dinámicos. Ciencia x tecnología x impacto.";
---

<Base title={title} description={description}>
  <Header />
  <main id="main">
    {/* Scroll-stage: the hero pins while the sheet below slides up over the
        Hopf ring, so the services read as a sheet rising onto the visual. */}
    <div class="hero-stage">
    <!-- HERO / LOBBY: full-bleed WebGL canvas, copy overlaid left -->
    <section id="top" class="hero hero-overlay" aria-labelledby="hero-heading">
      <div class="hero-bg" aria-hidden="false">
        <HopfHero />
      </div>
      {/* EN exception: equations stay in English (math notation) */}
      <aside class="hero-equations" aria-label="Hopf fibration equations">
        <p class="eq-title">Hopf Fibration</p>
        <p class="eq-line">Hopf Fibration — S3→S2 mapping</p>
        <p class="eq-line">(z1,z2) = (cos(θ/2)·e^(it), sin(θ/2)·e^(i(t+φ)))</p>
        <p class="eq-line">d = 1 − b·sin(t+φ)</p>
      </aside>
      <div class="wrap hero-copy-layer">
        <div class="hero-copy" data-hero-copy>
          <p class="hero-eyebrow">DATA / AUTOMATION</p>
          {/* EN exception: do not translate */}
          <h1 id="hero-heading"><span class="h1-line1">{HERO_LINE1}</span>{" "}<span class="h1-line2">{HERO_LINE2}</span></h1>
          <p class="lede">
            Convertimos sistemas complejos en productos claros: datos,
            seguridad y automatización con rigor científico.
          </p>
          <div class="hero-ctas">
            <a class="cta-primary" href="#services" id="hero-cta" data-magnetic>
              Explore our solutions <span aria-hidden="true">→</span>
            </a>
            <a class="cta-ghost" href="#contact" data-magnetic>Get in touch</a>
          </div>
        </div>
        <div class="hero-pillars" aria-label="Pilares destacados">
          {
            orderedPillars.map((p) => (
              <div class="hero-pillar" data-hero-pillar={p.data.key}>
                {p.data.key === "data" && (
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 13V7M6 13V3M10 13v-6M14 13V5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                )}
                {p.data.key === "automation" && (
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8a5 5 0 0 1 8.7-3.4M13 8a5 5 0 0 1-8.7 3.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11.5 1.8v2.6h-2.6M4.5 14.2v-2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
                <div class="hero-pillar-copy">
                  <strong>{p.data.title}</strong>
                  <span>{p.data.tagline}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <p class="hero-tag" aria-hidden="true">HOPF FIELD · 36 FIBERS · LIVE</p>
    </section>

    {/* Sheet: opaque panel with a rounded top edge that rises over the
        pinned hero as the user scrolls. */}
    <div class="sheet" data-sheet>
    <!-- PILLARS -->
    <section id="pillars" class="section" aria-labelledby="pillars-heading" data-reveal>
      <div class="wrap">
        <h2 id="pillars-heading" tabindex="-1">Pilares</h2>
        <div class="pillar-grid">
          {
            orderedPillars.map((p) => (
              <article class="pillar-card" data-pillar={p.data.key}>
                <h3>{p.data.title}</h3>
                <p>{p.data.tagline}</p>
                {/* Qualitative practice line per pillar: a practice, not a product claim. */}
                {p.data.key === "data" && (
                  <p class="pillar-proof">
                    Del historial disperso a la lista priorizada: cada lead llega con contexto.
                  </p>
                )}
                {p.data.key === "automation" && (
                  <p class="pillar-proof">
                    Lo repetitivo se hace solo; tu equipo solo decide lo importante.
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="section" aria-labelledby="services-heading" data-reveal>
      <div class="wrap">
        <h2 id="services-heading" tabindex="-1">Soluciones</h2>
        <p class="section-lede">
          Ocho soluciones, el mismo estándar de calidad.
          Elige por dónde empezar.
        </p>
        <div class="card-grid">
          {
            services.map((s) => (
              <article class="card card-full" data-card={s.slug}>
                <p class="pillar-tag">{pillarLabel[s.data.pillar]}</p>
                <span class="icon-box" aria-hidden="true">
                  {s.data.pillar === "data" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M2 13V7M6 13V3M10 13v-6M14 13V5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  )}
                  {s.data.pillar === "automation" && (
                    <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M3 8a5 5 0 0 1 8.7-3.4M13 8a5 5 0 0 1-8.7 3.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11.5 1.8v2.6h-2.6M4.5 14.2v-2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                </span>
                <h3>{s.data.title}</h3>
                {/* DRAFT badge: rendered only when frontmatter sets draftLabel. */}
                {s.data.draftLabel && <p class="draft-badge">{s.data.draftLabel}</p>}
                <p class="card-summary-text">{s.data.summary}</p>
                <ul>
                  {s.data.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                {/* Qualitative outcome line: rendered only when frontmatter sets outcome. */}
                {s.data.outcome && <p class="card-outcome">{s.data.outcome}</p>}
                <a class="example-hint" href={`${baseUrl}servicios/${s.slug}`}>Ver ejemplo en vivo <span class="arrow-chip" aria-hidden="true">→</span></a>
              </article>
            ))
          }
        </div>
        <div class="ally-block">
          <h3>Tu aliado en la transformación digital</h3>
          <p>
            Empezamos por un caso de uso acotado, medimos impacto y luego
            escalamos. Sin big-bang, sin humo.
          </p>
          <div class="ally-actions">
            <a class="cta-primary" href="#contact" data-magnetic>Solicita una demo</a>
          </div>
        </div>
      </div>
    </section>
    </div>
    </div>

    <!-- VISION / MISSION -->
    <section id="vision" class="section" aria-labelledby="vision-heading" data-reveal>
      <div class="wrap vm-grid">
        <article class="vm-card">
          <h2 id="vision-heading">{vision?.data.title ?? "Visión"}</h2>
          <p class="tbd-label">TBD — texto oficial pendiente</p>
          <div class="vm-body">
            {vision ? <p>{vision.body}</p> : <p>Contenido pendiente (TBD).</p>}
          </div>
        </article>
        <article class="vm-card">
          <h2 id="mission-heading">{mission?.data.title ?? "Misión"}</h2>
          <p class="tbd-label">TBD — texto oficial pendiente</p>
          <div class="vm-body">
            {mission ? <p>{mission.body}</p> : <p>Contenido pendiente (TBD).</p>}
          </div>
        </article>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section" aria-labelledby="contact-heading" data-reveal>
      <div class="wrap contact-wrap">
        <h2 id="contact-heading" tabindex="-1">Contacto</h2>
        <p>
          Cuéntanos tu caso: respondemos en menos de 48 horas hábiles.
        </p>
        <ul class="contact-list">
          <li><a href="mailto:hola@lamnda.example.com">hola@lamnda.example.com</a></li>
          <li><a href="#top">Volver al inicio</a></li>
        </ul>
        <form class="contact-form" action="mailto:hola@lamnda.example.com" method="post" enctype="text/plain">
          <label>Nombre<input type="text" name="nombre" required autocomplete="name" /></label>
          <label>Correo<input type="email" name="correo" required autocomplete="email" /></label>
          <label>Mensaje<textarea name="mensaje" rows="4" required></textarea></label>
          <button type="submit">Enviar</button>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 0.9rem;
  }
  .hero {
    padding: 3.5rem 0 2.5rem;
  }
  .hero-overlay {
    /* Pinned inside .hero-stage so the sheet below can slide up over the
       Hopf ring: the visual stays, the services rise onto it. */
    position: sticky;
    top: 0;
    z-index: 0;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 5rem 0 4rem;
    overflow: clip;
    background: var(--bg);
  }
  .hero-stage {
    position: relative;
  }
  .sheet {
    position: relative;
    z-index: 2;
    background: var(--bg);
    border-radius: 28px 28px 0 0;
    box-shadow: 0 -30px 70px rgb(0 0 0 / 0.45);
    padding-top: 0.8rem;
  }
  html[data-theme="light"] .sheet {
    box-shadow: 0 -30px 70px rgb(16 26 43 / 0.14);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg::after {
    /* Left scrim keeps overlaid copy legible over the fibers. */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--hero-scrim-strong) 0%,
      var(--hero-scrim-mid) 34%,
      var(--hero-scrim-soft) 62%,
      transparent 78%
    );
    pointer-events: none;
  }
  .hero-copy-layer {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-copy {
    max-width: 32rem;
    will-change: transform, opacity;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    line-height: 1.08;
    margin: 0 0 1rem;
  }
  .lede {
    font-size: 1.12rem;
    color: var(--muted);
    max-width: 34rem;
  }
  .hero-ctas {
    display: flex;
    gap: 0.8rem;
    margin: 1.4rem 0;
    flex-wrap: wrap;
  }
  .cta-primary {
    background: var(--primary-text);
    /* AA: dark #0A1628 on #7AB3FF = 8.39:1 (white-on-#7AB3FF was 2.16:1 FAIL) */
    color: #0a1628;
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
  }
  html[data-theme="light"] .cta-primary {
    color: #fff;
  }
  .cta-ghost {
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
  }
  .section {
    padding: 3rem 0 1rem;
  }
  .section h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin: 0 0 0.6rem;
  }
  .section-lede {
    color: var(--muted);
    max-width: 44rem;
  }
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .pillar-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem;
  }
  .pillar-card h3 {
    margin: 0 0 0.4rem;
  }
  .pillar-card p {
    margin: 0;
    color: var(--muted);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.4rem;
  }
  #services .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.7rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  #services .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--primary-text);
  }
  #services .icon-box {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--primary-text);
    flex: none;
  }
  .pillar-tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary-text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    margin: 0;
  }
  #services .card h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  #services .card-summary-text {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }
  #services .card ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    display: grid;
    gap: 0.4rem;
  }
  /* New v7 rows: DRAFT badge shares the TBD visual language. */
  .draft-badge {
    display: inline-block;
    font-size: 0.78rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
    margin: 0.8rem 0 0;
  }
  #services .card-outcome {
    margin: 0;
    color: var(--text);
    font-weight: 600;
    border-left: 3px solid var(--primary-text);
    background: var(--surface);
    border-radius: 0 8px 8px 0;
    padding: 0.6rem 0.9rem;
  }
  #services .example-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
  }
  #services .example-hint .arrow-chip {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    background: var(--primary-text);
    color: var(--bg);
    transition: transform 0.2s ease;
  }
  #services .example-hint:hover .arrow-chip {
    transform: translateX(4px);
  }
  #services .example-hint:focus-visible {
    outline: 3px solid var(--primary-text);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    #services .card {
      transition: none;
    }
    #services .card:hover {
      transform: none;
    }
    #services .example-hint .arrow-chip {
      transition: none;
    }
    #services .example-hint:hover .arrow-chip {
      transform: none;
    }
  }
  .hero-proof {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 32rem;
    margin: 0.6rem 0 0;
  }
  .pillar-proof {
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }
  .ally-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .ally-block {
    margin-top: 1.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
  }
  .vm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .vm-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
  }
  .tbd-label {
    display: inline-block;
    font-size: 0.78rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
  }
  .contact-wrap {
    max-width: 720px;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .contact-form {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .contact-form label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  .contact-form input,
  .contact-form textarea {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    font: inherit;
  }
  .contact-form button {
    background: var(--primary-text);
    /* AA: dark #0A1628 on #7AB3FF = 8.39:1; light override below keeps white on #0A54C2 = 6.86:1 */
    color: #0a1628;
    border: 0;
    border-radius: 999px;
    padding: 0.7rem 1.2rem;
    font-weight: 600;
    cursor: pointer;
    justify-self: start;
  }
  html[data-theme="light"] .contact-form button {
    color: #fff;
  }
  @media (max-width: 900px) {
    .hero-overlay {
      min-height: 92svh;
    }
    .hero-bg::after {
      background: linear-gradient(
        180deg,
        var(--hero-scrim-mobile-top) 0%,
        var(--hero-scrim-mobile-mid) 45%,
        var(--hero-scrim-mobile-bottom) 100%
      );
    }
    .pillar-grid,
    .card-grid,
    .vm-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initMotion } from "../lib/reveal.ts";
  initMotion();
</script>

<script is:inline>
  // Smooth-scroll CTA with focus management; native anchor jump is the no-JS fallback.
  document.getElementById("hero-cta")?.addEventListener("click", function (ev) {
    var target = document.getElementById("services-heading");
    if (!target) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    ev.preventDefault();
    target.scrollIntoView({ behavior: "smooth", block: "start" });
    target.focus({ preventScroll: true });
    history.replaceState(null, "", "#services");
  });
</script>

<script is:inline>
  // Sheet-over-hero cover detection: once the sheet has risen over the Hopf
  // ring, the canvas is hidden behind it, so the renderer pauses instead of
  // burning CPU on an invisible animation. Flag lives on <html> so the hero
  // island can read it without coupling to this page.
  (function () {
    var sheet = document.querySelector("[data-sheet]");
    if (!sheet) return;
    // Reduced motion keeps the hero static: there is no animation to pause,
    // so this listener stays out of the way (and adds no rAF churn).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var root = document.documentElement;
    var queued = false;
    function sync() {
      queued = false;
      var top = sheet.getBoundingClientRect().top;
      var covered = top <= window.innerHeight * 0.45;
      var next = covered ? "true" : "false";
      if (root.getAttribute("data-hero-covered") !== next) {
        root.setAttribute("data-hero-covered", next);
      }
    }
    function request() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(sync);
    }
    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request, { passive: true });
    sync();
  })();
</script>
