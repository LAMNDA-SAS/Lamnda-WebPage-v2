---
/* Service detail template: collections-driven static routes, zero-cost static. */
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import DemoLeadScoring from "../../components/demos/DemoLeadScoring.astro";
import DemoMarketingBots from "../../components/demos/DemoMarketingBots.astro";
import DemoNotificaciones from "../../components/demos/DemoNotificaciones.astro";
import DemoBotsCrm from "../../components/demos/DemoBotsCrm.astro";
import DemoTeleAgentes from "../../components/demos/DemoTeleAgentes.astro";
import DemoDocumentos from "../../components/demos/DemoDocumentos.astro";
import DemoDashboards from "../../components/demos/DemoDashboards.astro";

export async function getStaticPaths() {
  const all = await getCollection("services");
  return all.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const bodyText = (entry.body ?? "").trim();
const baseUrl = import.meta.env.BASE_URL;

const pillarLabel: Record<string, string> = {
  data: "Data Science",
  automation: "Automations",
};

/* SEO: page-specific title, derived description capped at 155 chars. */
const pageTitle = `${entry.data.title} — Lamnda`;
const rawDesc = entry.data.outcome ?? entry.data.summary;
const pageDesc = rawDesc.length > 155 ? rawDesc.slice(0, 152).trimEnd() + "..." : rawDesc;
const heroSub = entry.data.outcome ?? entry.data.summary;

/* Value bullets: 3 frontmatter + 1 body-derived, the same shape for every
   service — no card-size variants, no invented practice rows. */
const valueBullets: string[] = [...entry.data.bullets, bodyText]
  .filter(Boolean)
  .slice(0, 4);
---

<Base title={pageTitle} description={pageDesc} lang="es">
  <Header />
  <main id="main">
    <div class="wrap">
      {/* Visible back control above the breadcrumb; outside the h1 flow.
          Same target the breadcrumb "Servicios" uses. */}
      <div class="back-row">
        <a class="back-link" href={`${baseUrl}#services`}>
          <span class="back-arrow" aria-hidden="true">←</span> Volver a Servicios
        </a>
      </div>
      <nav aria-label="breadcrumb" class="crumbs">
        <a href={`${baseUrl}#services`}>Servicios</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{entry.data.title}</span>
      </nav>

      <header class="detail-hero">
        <p class="pillar-tag">{pillarLabel[entry.data.pillar]}</p>
        <h1>{entry.data.title}</h1>
        <p class="detail-sub">{heroSub}</p>
        {entry.data.draftLabel && <p class="draft-badge">{entry.data.draftLabel}</p>}
      </header>

      <section class="detail-values" aria-labelledby="valor-heading">
        <h2 id="valor-heading">Qué incluye</h2>
        <ul class="value-list">
          {valueBullets.map((b) => <li>{b}</li>)}
        </ul>
      </section>

      <section class="detail-demo" aria-labelledby="ejemplo-heading">
        <h2 id="ejemplo-heading">Ejemplo</h2>

        {entry.slug === "notificaciones-inteligentes" && (
          <figure class="demo-figure">
            <DemoNotificaciones />
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}

        {entry.slug === "documentacion-automatizada" && (
          <figure class="demo-figure">
            <DemoDocumentos />
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}

        {entry.slug === "bots-crm" && (
          <figure class="demo-figure">
            <DemoBotsCrm />
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}

        {entry.slug === "tele-agentes-ia" && (
          <figure class="demo-figure">
            <DemoTeleAgentes />
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}

        {entry.slug === "lead-scoring" && (
          <figure class="demo-figure">
            <DemoLeadScoring />
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}

        {entry.slug === "marketing-bots" && (
          <figure class="demo-figure">
            <DemoMarketingBots />
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}

        {entry.slug === "dashboards-dinamicos" && (
          <figure class="demo-figure">
            <DemoDashboards />
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}

        {entry.slug === "agendamiento-automatico" && (
          <figure class="demo-figure">
            <div class="demo-mock" role="img" aria-label="Mock ilustrativo de flujo de agenda automática">
              <div class="chip-row" aria-hidden="true">
                <span>Mañana</span><span>09:00</span><span>11:30</span><span>16:00</span>
              </div>
              <div class="flow">
                <span>Propuesta</span>
                <span aria-hidden="true">→</span>
                <span>Confirmación</span>
                <span aria-hidden="true">→</span>
                <span>Recordatorio</span>
              </div>
              <p class="flow-note">Reprogramación sin llamadas de más</p>
            </div>
            <figcaption>Mock ilustrativo — sin datos reales</figcaption>
          </figure>
        )}
      </section>

      <div class="detail-cta">
        <a class="cta-primary" href={`${baseUrl}#contact`}>Solicita una demo</a>
        <a class="cta-ghost" href={`${baseUrl}#services`}>Volver a servicios</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 2.5rem 0.9rem 3rem;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0 0 1.4rem;
  }
  .back-row {
    margin: 0 0 0.9rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary-text);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.95rem 0.4rem 0.8rem;
  }
  .back-link:hover {
    border-color: var(--primary-text);
  }
  .back-link:focus-visible {
    outline: 3px solid var(--primary-text);
    outline-offset: 3px;
  }
  .back-link .back-arrow {
    transition: transform 0.2s ease;
  }
  .back-link:hover .back-arrow {
    transform: translateX(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .back-link .back-arrow {
      transition: none;
      transform: none;
    }
  }
  .detail-hero {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }
  .pillar-tag {
    display: inline-block;
    justify-self: start;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary-text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    margin: 0;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.12;
    margin: 0;
  }
  .detail-sub {
    font-size: 1.1rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
    max-width: 44rem;
  }
  .draft-badge {
    display: inline-block;
    justify-self: start;
    font-size: 0.78rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
    margin: 0;
  }
  .detail-values h2,
  .detail-demo h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.9rem;
  }
  .detail-values {
    margin-bottom: 2rem;
  }
  .value-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.6rem;
    color: var(--text);
    line-height: 1.65;
  }
  .demo-figure {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
  }
  .demo-mock {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    display: grid;
    gap: 0.7rem;
  }
  .demo-figure figcaption {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.7rem;
  }
  .chip-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .chip-row span {
    color: var(--muted);
  }
  .flow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
  }
  .detail-cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
  }
  .cta-primary {
    background: var(--primary-text);
    color: var(--bg);
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
  }
  .cta-ghost {
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
  }
  @media (max-width: 600px) {
    .wrap {
      padding-top: 1.6rem;
    }
    .demo-figure {
      padding: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-primary,
    .cta-ghost {
      transition: none;
    }
  }
</style>
