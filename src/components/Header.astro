---
/* Site header: sticky nav with anchor links + theme toggle. */
const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header" data-site-header>
  <div class="wrap">
    <a class="brand" href={`${baseUrl}#top`} aria-label="Lamnda — inicio">
      <img
        class="brand-shield"
        src={`${baseUrl}logos/lamnda-mark.png`}
        alt="Lamnda"
        width="32"
        height="32"
        decoding="async"
      />
      <span class="brand-name">Lamnda</span>
    </a>
    <nav class="nav" aria-label="Navegación principal">
      <a href={`${baseUrl}#top`} aria-current="page">Home</a>
      <a href={`${baseUrl}#services`}>Solutions</a>
      <a href={`${baseUrl}#pillars`} data-pillar-link="data">Data Science</a>
      <a href={`${baseUrl}#pillars`} data-pillar-link="automation">Automations</a>
      <a href={`${baseUrl}#vision`}>About</a>
    </nav>
    <div class="actions">
      <button type="button" data-theme-toggle aria-pressed="false" aria-label="Cambiar tema">
        <span aria-hidden="true">◐</span>
        <span data-theme-label>Oscuro</span>
      </button>
      <a class="cta-small" href={`${baseUrl}#contact`}>Get in touch <span aria-hidden="true">→</span></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .site-header.scrolled {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(16px);
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.7rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    margin-right: auto;
  }
  .brand-shield {
    width: 32px;
    height: 32px;
    object-fit: contain;
    border-radius: 8px;
  }
  html[data-theme="dark"] .brand-shield {
    filter: drop-shadow(0 0 12px rgb(46 140 255 / 0.35));
  }
  .brand-name {
    color: var(--text);
  }
  .nav {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .nav a:hover {
    color: var(--text);
  }
  .nav a[aria-current="page"] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--primary-text);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  [data-theme-toggle] {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .cta-small {
    background: transparent;
    border: 1px solid var(--primary-text);
    /* AA: --primary-text on --bg both themes (dark #7AB3FF on #0A1628 ~7:1, light #0A54C2 on #fff ~7.5:1) */
    color: var(--primary-text);
    text-decoration: none;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  html[data-theme="light"] .cta-small {
    color: var(--primary-text);
  }
  @media (max-width: 860px) {
    .nav {
      display: none;
    }
  }
</style>
