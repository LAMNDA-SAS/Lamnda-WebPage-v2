---
/* HopfHero island: poster-first LCP, lazy 2D Canvas on idle+visible.
 * Reduced-motion: single 2D frame + one frame per pointermove,
 * zero rAF at rest, no visible banner (sr-only failure text only).
 * Hero JS ruling: 2D renderer is a small sync import (<15KB gzip);
 * no async WebGL chunk exists anymore.
 */
export interface Props {
  posterSrc?: string;
  posterLightSrc?: string;
  fiberCount?: number;
  autoRotate?: boolean;
}

const hopfEnabled = import.meta.env.PUBLIC_HOPF_ENABLED !== "false";

const {
  posterSrc = "/hero-poster-dark.webp",
  posterLightSrc = "/hero-poster-light.webp",
  fiberCount,
  autoRotate,
} = Astro.props;
---

<div
  class="hopf-hero"
  data-hopf-root
  data-fiber-count={fiberCount ?? ""}
  data-auto-rotate={autoRotate ?? ""}
  data-hopf-enabled={String(hopfEnabled)}
  data-poster-dark={posterSrc}
  data-poster-light={posterLightSrc}
>
  <img
    class="hopf-poster"
    src={posterSrc}
    alt=""
    width="1600"
    height="1000"
    fetchpriority="high"
    decoding="async"
    data-hopf-poster
  />
  <canvas
    class="hopf-canvas"
    aria-hidden="true"
    data-hopf-canvas
    hidden
  ></canvas>
  <button
    type="button"
    class="hopf-toggle"
    data-hopf-toggle
    aria-pressed="false"
    hidden
  >Animar motion</button>
  <p class="hopf-note sr-only" data-hopf-status role="status"></p>
</div>

<script>
  import {
    HOPF_ENABLED,
    createHopf2D,
    prefersReducedMotion,
    readTheme,
  } from "../lib/hopf-2d.ts";

  (function () {
    var root = document.querySelector("[data-hopf-root]");
    if (!root) return;
    var canvas = root.querySelector("[data-hopf-canvas]");
    var poster = root.querySelector("[data-hopf-poster]");
    var status = root.querySelector("[data-hopf-status]");
    if (!canvas || !poster) return;

    function say(msg) {
      if (status) status.textContent = msg;
    }

    function posterForTheme() {
      var theme = readTheme();
      var dark = root.getAttribute("data-poster-dark") || "/hero-poster-dark.webp";
      var light = root.getAttribute("data-poster-light") || "/hero-poster-light.webp";
      return theme === "light" ? light : dark;
    }

    function swapPoster() {
      var next = posterForTheme();
      var cur = poster.getAttribute("src");
      if (cur !== next) poster.setAttribute("src", next);
    }

    // Themed poster swap before paint; keeps working on toggle (poster-only too).
    swapPoster();
    if (typeof MutationObserver !== "undefined") {
      new MutationObserver(swapPoster).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }

    // Escape hatch: poster-only, no status banner (sr-only stays empty).
    // Toggle stays hidden here: it is revealed only after hydrate succeeds.
    var flag = root.getAttribute("data-hopf-enabled");
    if (!HOPF_ENABLED || flag === "false") {
      return;
    }

    // Tri-state hero motion mode. Default `auto` preserves current behavior;
    // explicit `on`/`off` only ever results from a direct toggle gesture.
    var MODE_KEY = "lamnda-hero-motion";
    function readMode() {
      try {
        var v = localStorage.getItem(MODE_KEY);
        return v === "on" || v === "off" ? v : "auto";
      } catch (e) {
        return "auto";
      }
    }
    function writeMode(m) {
      try {
        localStorage.setItem(MODE_KEY, m);
      } catch (e) {
        // Private-mode storage: session-only, hydration continues.
      }
    }
    // Effective reduced-motion flag. False means animating (drift).
    function resolveEffective(osRM, mode) {
      return mode === "on" ? false : mode === "off" ? true : osRM;
    }

    var toggle = root.querySelector("[data-hopf-toggle]");
    var mode = readMode();
    var reduced = resolveEffective(prefersReducedMotion(), mode);
    var started = false;

    function paintToggle() {
      if (!toggle) return;
      var animating = !reduced;
      toggle.setAttribute("aria-pressed", String(animating));
      toggle.textContent = animating ? "Pausar motion" : "Animar motion";
    }

    function showCanvas() {
      canvas.hidden = false;
      poster.setAttribute("aria-hidden", "true");
      // Keep poster underneath as fallback; canvas swaps in place (no CLS).
      poster.style.opacity = "0";
      poster.style.pointerEvents = "none";
      say("");
      // Reveal the toggle only once hydration succeeded (poster-first LCP).
      if (toggle) {
        paintToggle();
        toggle.hidden = false;
      }
    }

    /* Sheet-cover signal: the page marks <html data-hero-covered> once the
       rising sheet hides the hero, so the renderer stops burning CPU on an
       invisible canvas. Separate from the offscreen/visibility pauses. */
    function coverState(): boolean {
      return (
        typeof document !== "undefined" &&
        document.documentElement.getAttribute("data-hero-covered") === "true"
      );
    }

    function applyCoverState(): void {
      var handle = root._hopfHandle;
      if (handle && typeof handle.setCovered === "function") {
        handle.setCovered(coverState());
      }
    }

    if (typeof MutationObserver !== "undefined") {
      new MutationObserver(applyCoverState).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-hero-covered"],
      });
    }

    function hydrate() {
      if (started) return;
      started = true;
      try {
        const handle = createHopf2D(canvas, { reducedMotion: reduced });
        showCanvas();
        applyCoverState();
        if (reduced) {
          // Single beauty frame is already painted inside createHopf2D;
          // pointermove re-renders one frame each (handled in the module).
          // Keep the handle alive; stop only on genuine teardown.
          root._hopfHandle = handle;
        } else {
          root._hopfHandle = handle;
        }
      } catch (e) {
        say("No se pudo iniciar la animación; mostrando imagen.");
      }
    }

    // Dispose the live handle and recreate it synchronously with the new
    // effective flag. Resets drift phase by one frame; zero lib risk.
    function swap(nextReduced) {
      reduced = nextReduced;
      var old = root._hopfHandle;
      if (old && typeof old.dispose === "function") {
        try {
          old.dispose();
        } catch (e) {}
      }
      root._hopfHandle = null;
      try {
        root._hopfHandle = createHopf2D(canvas, { reducedMotion: reduced });
      } catch (e) {
        say("Motion state unchanged; showing image.");
        return;
      }
      paintToggle();
      // Hero-only announcement; never implies an OS setting changed.
      say(reduced ? "Hero motion off." : "Hero motion on.");
    }

    if (toggle) {
      paintToggle();
      toggle.addEventListener("click", function () {
        // Binary flip of the live state; the first gesture leaves `auto`
        // behind and persists an explicit per-site choice.
        var next = reduced ? "on" : "off";
        writeMode(next);
        mode = next;
        if (!started) {
          reduced = resolveEffective(prefersReducedMotion(), mode);
          paintToggle();
          return;
        }
        swap(resolveEffective(prefersReducedMotion(), mode));
      });
    }

    // OS reduced-motion changes re-resolve only while in `auto`;
    // explicit `on`/`off` ignores them.
    if (typeof window.matchMedia === "function") {
      var rmQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      function onOsChange(e) {
        if (readMode() !== "auto") return;
        mode = "auto";
        if (!started) {
          reduced = resolveEffective(e.matches, "auto");
          paintToggle();
          return;
        }
        swap(resolveEffective(e.matches, "auto"));
      }
      if (typeof rmQuery.addEventListener === "function") {
        rmQuery.addEventListener("change", onOsChange);
      } else if (typeof rmQuery.addListener === "function") {
        rmQuery.addListener(onOsChange);
      }
    }

    // Reduced-motion still hydrates (single frame, zero rAF at rest).
    // Lazy-hydrate on idle AND visible (poster paints first for LCP).
    var visible = false;
    function maybeStart() {
      if (visible && !started) {
        if (reduced) {
          hydrate();
        } else if ("requestIdleCallback" in window) {
          requestIdleCallback(hydrate, { timeout: 2500 });
        } else {
          setTimeout(hydrate, 600);
        }
      }
    }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            visible = true;
            maybeStart();
          }
        }
      }).observe(root);
    } else {
      visible = true;
      maybeStart();
    }
  })();
</script>

<style>
  .hopf-hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--bg);
  }
  .hopf-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      90% 90% at 75% 38%,
      rgb(46 140 255 / 0.16) 0%,
      transparent 60%
    );
    pointer-events: none;
  }
  html[data-theme="light"] .hopf-hero::before {
    background: radial-gradient(
      90% 90% at 75% 38%,
      rgb(46 140 255 / 0.1) 0%,
      transparent 60%
    );
  }
  .hopf-poster,
  .hopf-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hopf-poster {
    transition: opacity 0.5s ease;
  }
  .hopf-toggle {
    position: absolute;
    left: 0.9rem;
    bottom: 1.2rem;
    z-index: 2;
    min-width: 44px;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .hopf-toggle:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 2px;
  }
  .hopf-toggle[hidden] {
    display: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .hopf-poster {
      transition: none;
    }
  }
</style>
