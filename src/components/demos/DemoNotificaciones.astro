<script is:inline>
/* Port of the old notifications tab-filter IIFE, 1:1 control flow with the
   old #ejemplo pivot replaced by the demo root (D1/D4). RM: click-driven
   row filtering, no autonomous motion; RM path is CSS-only. */
(function () {
    try {
        var REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var root = document.querySelector('[data-demo="notificaciones-inteligentes"]');
        if (!root) return;
        var t = root.querySelectorAll('.example-tab');
        var a = root.querySelectorAll('.example-alert');
        t.forEach(function (b) {
            b.addEventListener('click', function () {
                t.forEach(function (x) {
                    x.classList.remove('example-tab-active');
                    x.setAttribute('aria-selected', 'false');
                });
                b.classList.add('example-tab-active');
                b.setAttribute('aria-selected', 'true');
                var f = b.dataset.filter;
                a.forEach(function (i) {
                    i.style.display = (f === 'all' || i.dataset.cat === f) ? 'flex' : 'none';
                });
            });
        });
    } catch (e) { if (window.console) console.warn('lamnda-demo', e); }
})();
</script>
