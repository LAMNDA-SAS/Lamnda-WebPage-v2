        var resetBtn = root.querySelector('#pdReset');
        var replayBtn = root.querySelector('#pdReplay');
        var names = { demographics: 'DEMOGRAPHICS DASHBOARD', financial: 'FINANCIAL HEALTH DASHBOARD', transactions: 'TRANSACTIONS DASHBOARD', cards: 'CARD DETAILS DASHBOARD' };
        var idx = 0, timer = null, liveTimer = null, paused = false;
        var CYCLE_MS = 4000, LIVE_MS = 3000;
        function fmt(v, d) { return Number(v).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d }); }
        function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }
        function drift(v, amt, lo, hi, dec) { var n = v + (Math.random() * 2 - 1) * amt; n = clamp(n, lo, hi); return dec ? Math.round(n * 10) / 10 : Math.round(n); }
        function pct(v, max) { return clamp(Math.round(v / max * 100), 2, 100) + '%'; }
        // Base dataset mirrors the static markup; S is the live working copy (single writer).
        var BASE = {
            age: [{ f: 92, m: 99 }, { f: 185, m: 182 }, { f: 180, m: 166 }, { f: 189, m: 191 }, { f: 156, m: 168 }, { f: 105, m: 94 }, { f: 109, m: 84 }],
            income: 45715.9, ageAvg: 45,
            fin: { c: 45, s: 35, total: 128450, score: 712, util: 32, seg: [22, 35, 48, 61, 74] },
            tx: { card: [62, 70, 58, 80, 74, 90], tr: [40, 45, 52, 60, 66, 72], top: [1240, 980, 845, 612, 488], vol: 86200 },
            cards: { use: 64, limit: 8500 }
        };
        var S = JSON.parse(JSON.stringify(BASE));
        function tween(el, to) {
            var dec = parseInt(el.getAttribute('data-decimals') || '0', 10);
            var pre = el.getAttribute('data-prefix') || '', suf = el.getAttribute('data-suffix') || '';
            var from = parseFloat(el.getAttribute('data-count'));
            if (isNaN(from)) from = to;
            el.setAttribute('data-count', to);
            if (REDUCED) { el.textContent = pre + fmt(to, dec) + suf; return; }
            var t0 = performance.now(), dur = 600;
            (function frame(t) {
                var p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
                el.textContent = pre + fmt(from + (to - from) * e, dec) + suf;
                if (p < 1) requestAnimationFrame(frame);
            })(t0);
        }
        function renderDemographics(paintOnly) {
            var view = root.querySelector('#pd-view-demographics');
            if (!paintOnly) {
                S.age.forEach(function (g) { g.f = drift(g.f, 3, 20, 250); g.m = drift(g.m, 3, 20, 250); });
                S.income = drift(S.income, 150, 44000, 47500, true);
                S.ageAvg = drift(S.ageAvg, 1, 44, 46);
            }
            var max = 1, sumF = 0, sumM = 0;
            S.age.forEach(function (g) { max = Math.max(max, g.f, g.m); sumF += g.f; sumM += g.m; });
            var groups = view.querySelectorAll('.pd-grid-r1 .pd-bar-group');
            Array.prototype.forEach.call(groups, function (gr, i) {
                if (!S.age[i]) return;
                var bars = gr.querySelectorAll('.pd-bar');
                if (bars[0]) { bars[0].style.height = pct(S.age[i].f, max); bars[0].setAttribute('title', 'Female ' + S.age[i].f); }
                if (bars[1]) { bars[1].style.height = pct(S.age[i].m, max); bars[1].setAttribute('title', 'Male ' + S.age[i].m); }
            });
            var kpis = view.querySelectorAll('.pd-grid-r1 .pd-kpi-value');
            var subs = view.querySelectorAll('.pd-grid-r1 .pd-kpi-sub');
            if (kpis[0]) tween(kpis[0], sumF + sumM);
            if (subs[0]) subs[0].innerHTML = '<strong>Male</strong> ' + fmt(sumM, 0) + '<br><strong>Female</strong> ' + fmt(sumF, 0);
            if (kpis[1]) tween(kpis[1], S.income);
            if (kpis[2]) tween(kpis[2], S.ageAvg);
            if (subs[2]) subs[2].innerHTML = '<strong>Male</strong> ' + S.ageAvg + '<br><strong>Female</strong> ' + clamp(S.ageAvg + 1, 44, 46);
            Array.prototype.forEach.call(view.querySelectorAll('.pd-donut-hole'), function (h) { h.textContent = fmt(sumF + sumM, 0); });
        }
        function renderFinancial(paintOnly) {
            var view = root.querySelector('#pd-view-financial'), F = S.fin;
            if (!paintOnly) {
                F.seg = F.seg.map(function (u) { return drift(u, 2, 5, 95); });
                F.c = drift(F.c, 1.5, 35, 55, true); F.s = drift(F.s, 1.5, 25, 45, true);
                if (F.c + F.s > 95) F.s = Math.round((95 - F.c) * 10) / 10;
                F.total = drift(F.total, 800, 115000, 140000);
                F.score = drift(F.score, 3, 680, 745); F.util = drift(F.util, 1, 25, 40);
            }
            var cr = Math.round((100 - F.c - F.s) * 10) / 10;
            var groups = view.querySelectorAll('.pd-bars .pd-bar-group');
            Array.prototype.forEach.call(groups, function (gr, i) {
                if (F.seg[i] == null) return;
                var bars = gr.querySelectorAll('.pd-bar'), av = 100 - F.seg[i];
                if (bars[0]) { bars[0].style.height = F.seg[i] + '%'; bars[0].setAttribute('title', 'Used ' + F.seg[i] + '%'); }
                if (bars[1]) { bars[1].style.height = av + '%'; bars[1].setAttribute('title', 'Available ' + av + '%'); }
            });
            var donut = view.querySelector('.pd-donut-balance');
            if (donut) donut.style.background = 'conic-gradient(var(--pd-donut-1) 0 ' + F.c + '%, var(--pd-donut-2) ' + F.c + '% ' + (F.c + F.s) + '%, var(--pd-donut-3) ' + (F.c + F.s) + '% 100%)';
            var legs = view.querySelectorAll('.pd-list li span:last-child');
            if (legs[0]) legs[0].textContent = fmt(F.c, 0) + '%';
            if (legs[1]) legs[1].textContent = fmt(F.s, 0) + '%';
            if (legs[2]) legs[2].textContent = fmt(cr, 0) + '%';
            var kpis = view.querySelectorAll('.pd-kpi-value'), subs = view.querySelectorAll('.pd-kpi-sub');
            var chk = Math.round(F.total * F.c / 100), sav = Math.round(F.total * F.s / 100);
            if (kpis[0]) tween(kpis[0], F.total);
            if (subs[0]) subs[0].innerHTML = '<strong>Checking</strong> $' + fmt(chk, 0) + '<br><strong>Savings</strong> $' + fmt(sav, 0);
            if (kpis[1]) tween(kpis[1], F.score);
            if (kpis[2]) tween(kpis[2], F.util);
            if (subs[2]) subs[2].innerHTML = '<strong>Limit</strong> $8,500 avg<br><strong>Used</strong> $' + fmt(Math.round(8500 * F.util / 100), 0) + ' avg';
            var hole = view.querySelector('.pd-donut-hole');
            if (hole) hole.textContent = '$' + Math.round(F.total / 1000) + 'K';
        }
        function renderTransactions(paintOnly) {
            var view = root.querySelector('#pd-view-transactions'), T = S.tx;
            if (!paintOnly) {
                T.card = T.card.map(function (v) { return drift(v, 3, 15, 95); });
                T.tr = T.tr.map(function (v) { return drift(v, 3, 15, 95); });
                T.top = T.top.map(function (v) { return drift(v, 40, 100, 2000); });
                for (var i = 1; i < T.top.length; i++) if (T.top[i] > T.top[i - 1] - 30) T.top[i] = T.top[i - 1] - 30;
                T.vol = drift(T.vol, 400, 78000, 95000);
            }
            var groups = view.querySelectorAll('.pd-bars .pd-bar-group');
            Array.prototype.forEach.call(groups, function (gr, i) {
                if (T.card[i] == null) return;
                var bars = gr.querySelectorAll('.pd-bar');
                if (bars[0]) { bars[0].style.height = T.card[i] + '%'; bars[0].setAttribute('title', 'Card ' + T.card[i]); }
                if (bars[1]) { bars[1].style.height = T.tr[i] + '%'; bars[1].setAttribute('title', 'Transfer ' + T.tr[i]); }
            });
            var rows = view.querySelectorAll('.pd-table tbody tr');
            Array.prototype.forEach.call(rows, function (r, i) {
                if (T.top[i] == null) return;
                var cell = r.querySelector('td:last-child');
                if (cell) { cell.textContent = '$' + fmt(T.top[i], 0); cell.setAttribute('data-label', T.top[i]); r.setAttribute('title', 'Amount $' + fmt(T.top[i], 0)); }
            });
            var kpis = view.querySelectorAll('.pd-kpi-value'), subs = view.querySelectorAll('.pd-kpi-sub');
            var cardAmt = Math.round(T.vol * 0.608), trAmt = T.vol - cardAmt;
            if (kpis[0]) tween(kpis[0], T.vol);
            if (subs[0]) subs[0].innerHTML = '<strong>Card</strong> $' + fmt(cardAmt, 0) + '<br><strong>Transfer</strong> $' + fmt(trAmt, 0);
        }
        function renderCards(paintOnly) {
            var view = root.querySelector('#pd-view-cards'), C = S.cards;
            if (!paintOnly) C.use = drift(C.use, 2, 50, 78);
            var used = Math.round(C.limit * C.use / 100), avail = C.limit - used;
            var ring = view.querySelector('.pd-donut-usage');
            if (ring) { ring.style.background = 'conic-gradient(var(--pd-donut-2) 0 ' + C.use + '%, var(--pd-donut-rest) ' + C.use + '% 100%)'; ring.setAttribute('title', C.use + '% used'); }
            var hole = view.querySelector('.pd-donut-hole');
            if (hole) hole.textContent = C.use + '% used';
            var legs = view.querySelectorAll('.pd-list li span:last-child');
            if (legs[0]) legs[0].textContent = '$' + fmt(used, 0);
            if (legs[1]) legs[1].textContent = '$' + fmt(avail, 0);
        }
        function renderActive(paintOnly) {
            var v = tabs[idx].getAttribute('data-view');
            if (v === 'financial') renderFinancial(paintOnly);
            else if (v === 'transactions') renderTransactions(paintOnly);
            else if (v === 'cards') renderCards(paintOnly);
            else renderDemographics(paintOnly);
        }
        function liveTick(force) { if (REDUCED || (!force && (paused || document.hidden))) return; renderActive(false); }
        function countUp(el) {
            var target = parseFloat(el.getAttribute('data-count')), dec = parseInt(el.getAttribute('data-decimals') || '0', 10);
            var pre = el.getAttribute('data-prefix') || '', suf = el.getAttribute('data-suffix') || '';
            if (REDUCED || isNaN(target)) { el.textContent = pre + fmt(isNaN(target) ? 0 : target, dec) + suf; return; }
            var t0 = performance.now(), dur = 1100;
            (function frame(t) {
                var p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
                el.textContent = pre + fmt(target * e, dec) + suf;
                if (p < 1) requestAnimationFrame(frame);
            })(t0);
        }
        function playEntrance(view) {
            if (REDUCED) return;
            view.classList.remove('in');
            void view.offsetWidth;
            Array.prototype.forEach.call(view.querySelectorAll('.pd-kpi-value[data-count]'), countUp);
            var bars = view.querySelectorAll('.pd-bar');
            Array.prototype.forEach.call(bars, function (b, i) { b.style.transitionDelay = Math.min(i * 30, 600) + 'ms'; });
            requestAnimationFrame(function () { requestAnimationFrame(function () { view.classList.add('in'); setTimeout(function () { Array.prototype.forEach.call(view.querySelectorAll('.pd-bar'), function (b) { b.style.transitionDelay = ''; }); }, 1000); }); });
        }
        function activate(i, manual) {
            idx = (i + views.length) % views.length;
            views.forEach(function (v, k) { v.classList.toggle('pd-view-active', k === idx); });
            tabs.forEach(function (t, k) {
                t.setAttribute('aria-selected', k === idx ? 'true' : 'false');
                t.closest('li').classList.toggle('pd-active', k === idx);
            });
            dots.forEach(function (d) { d.classList.remove('is-active'); d.removeAttribute('aria-current'); });
            if (dots[idx]) {
                void dash.offsetWidth;
                dots[idx].classList.add('is-active');
                dots[idx].setAttribute('aria-current', 'true');
            }
            title.textContent = names[tabs[idx].getAttribute('data-view')] || names.demographics;
            playEntrance(views[idx]);
            if (manual) restart();
        }
        function restart() {
            if (REDUCED) return;
            clearInterval(timer);
            timer = setInterval(function () { if (!paused && !document.hidden) activate(idx + 1, false); }, CYCLE_MS);
            clearInterval(liveTimer);
            liveTimer = setInterval(function () { liveTick(false); }, LIVE_MS);
        }
        function setPaused(v) { paused = v; dash.classList.toggle('is-paused', v); }
        tabs.forEach(function (t, k) { t.addEventListener('click', function () { activate(k, true); }); });
        dots.forEach(function (d) { d.addEventListener('click', function () { activate(parseInt(d.getAttribute('data-goto'), 10) || 0, true); }); });
        resetBtn.addEventListener('click', function () { S = JSON.parse(JSON.stringify(BASE)); renderDemographics(true); renderFinancial(true); renderTransactions(true); renderCards(true); activate(0, true); });
        replayBtn.addEventListener('click', function () { if (!REDUCED) liveTick(true); activate(idx, true); });
        dash.addEventListener('mouseenter', function () { setPaused(true); });
        dash.addEventListener('mouseleave', function () { setPaused(false); });
        dash.addEventListener('focusin', function () { setPaused(true); });
        dash.addEventListener('focusout', function () { setPaused(false); });
        if (!REDUCED) { dash.classList.add('pd-anim'); activate(0, false); restart(); }
        else { var badge = dash.querySelector('.pd-live-badge'); if (badge) badge.setAttribute('title', 'Live updates paused (prefers-reduced-motion): showing static data'); }
    } catch (e) { if (window.console) console.warn('lamnda-demo', e); }
})();
</script>
