<script is:inline>
/* Port of the old CRM drag & drop + owner-filter IIFE, 1:1 control flow,
   scoped to the demo root (D1/D4). RM: user drag/type interactions only. */
(function () {
    try {
        var REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var root = document.querySelector('[data-demo="bots-crm"]');
        if (!root) return;
        var board = root.querySelector('#crmBoard');
        if (!board) return;
        var drag = null;
        function fmt(v) { return '$' + v.toFixed(1).replace('.', ',') + 'M COP'; }
        function visibleCards(col) {
            return Array.prototype.slice.call(col.querySelectorAll('.example-crm-card')).filter(function (c) { return !c.hidden; });
        }
        function update() {
            var grand = 0, grandN = 0;
            board.querySelectorAll('.example-crm-col').forEach(function (col) {
                var cards = visibleCards(col);
                var sum = cards.reduce(function (a, c) { return a + (parseFloat(c.getAttribute('data-value')) || 0); }, 0);
                grand += sum; grandN += cards.length;
                var n = col.querySelector('[data-count]');
                var t = col.querySelector('[data-total]');
                if (n) n.textContent = cards.length;
                if (t) t.textContent = fmt(sum);
            });
            var total = root.querySelector('#crmTotal');
            if (total) total.textContent = fmt(grand);
            var count = root.querySelector('#crmVisible');
            if (count) count.textContent = grandN + (grandN === 1 ? ' oportunidad' : ' oportunidades');
            var foot = root.querySelector('#crmCount');
            if (foot) foot.textContent = grandN + (grandN === 1 ? ' oportunidad' : ' oportunidades') + ' · Datos de muestra';
        }
        board.querySelectorAll('.example-crm-card').forEach(function (c) {
            c.addEventListener('dragstart', function () { drag = c; c.classList.add('example-crm-dragging'); });
            c.addEventListener('dragend', function () { c.classList.remove('example-crm-dragging'); });
        });
        board.querySelectorAll('.example-crm-col').forEach(function (col) {
            col.addEventListener('dragover', function (e) { e.preventDefault(); col.classList.add('example-crm-over'); });
            col.addEventListener('dragleave', function () { col.classList.remove('example-crm-over'); });
            col.addEventListener('drop', function (e) {
                e.preventDefault();
                col.classList.remove('example-crm-over');
                if (drag) { col.appendChild(drag); drag = null; update(); }
            });
        });
        var filter = root.querySelector('#crmFilter');
        if (filter) {
            filter.addEventListener('input', function () {
                var q = filter.value.trim().toLowerCase();
                board.querySelectorAll('.example-crm-card').forEach(function (c) {
                    var o = (c.getAttribute('data-owner') || '').toLowerCase();
                    c.hidden = q && o.indexOf(q) === -1;
                });
                update();
            });
        }
        update();
    } catch (e) { if (window.console) console.warn('lamnda-demo', e); }
})();
</script>
