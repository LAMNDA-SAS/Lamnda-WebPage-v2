---
/**
 * Port of the old site's `service-marketing-bots.html` `#ejemplo` live demo.
 * Verbatim markup and class names; used-selector CSS remapped to v2 tokens
 * under the `[data-demo="marketing-bots"]` root (design D3). One guarded
 * inline IIFE (D1/D4). RM policy: CSS-only — the chat replay is user-initiated
 * and carries no autonomous CSS animation on the old page either.
 * Directed adaptations: old CTAs dropped; ▶/↺ glyph buttons become text
 * ("Reproducir"/"Repetir"); lead card inline opacity:.4 becomes an
 * `is-idle` scoped rule toggled by JS; avatar SVGs retokened (no raw navy/pink).
 */
---
<div class="example-inner" data-demo="marketing-bots">
    <span class="example-badge">Ejemplo en vivo</span>
    <h3 class="example-outcome">Tu Instagram y tu email venden mientras duermes</h3>
    <p class="example-sub">El bot responde el DM, califica y agenda. Pulsa reproducir para ver la captura.</p>
    <ul class="example-kpis">
        <li>+23% conversión</li>
        <li>24/7 respuesta</li>
        <li class="example-kpi-accent">Lead capturado</li>
    </ul>
    <p class="example-sample-note">Datos de muestra con fines ilustrativos.</p>
    <div class="example-frame">
        <div class="example-frame-bar"><span class="example-frame-dot"></span><span class="example-frame-dot"></span><span class="example-frame-dot"></span><span class="example-frame-title">Marketing bot · Instagram + Email</span></div>
        <div class="example-frame-body">
            <div class="example-two-col">
                <div>
                    <div class="example-tabs"><button type="button" class="example-play-btn" id="chatPlay">Reproducir</button></div>
                    <div class="example-chat" id="chatBox" aria-live="polite"></div>
                </div>
                <div class="example-lead-card is-idle" id="leadCard"><strong>Lead capturado</strong><ul class="example-lead-list" id="leadText"><li>Se completará al finalizar la conversación…</li></ul><br><span>→ Email drip día 1, 3 y 7 programado.</span></div>
            </div>
        </div>
    </div>
</div>

<style is:global>
/* Marketing bots demo — old demos.css used-selectors rebased from .live-example
   to [data-demo="marketing-bots"], colors remapped to v2 tokens (design D3/D7). */

[data-demo="marketing-bots"] {
    --demo-ok: #4ade80;
    --demo-warn: #fbbf24;
    --demo-danger: #f87171;
    max-width: 960px;
    margin: 0 auto;
}

html[data-theme="light"] [data-demo="marketing-bots"] {
    --demo-ok: #15803d;
    --demo-warn: #b45309;
    --demo-danger: #b91c1c;
}

[data-demo="marketing-bots"] .example-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 50px;
    padding: 6px 14px;
    margin-bottom: 16px;
}

[data-demo="marketing-bots"] h3.example-outcome {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.25;
    margin: 0 0 12px;
    letter-spacing: -0.5px;
}

[data-demo="marketing-bots"] .example-sub {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0 0 20px;
    max-width: 700px;
}

[data-demo="marketing-bots"] .example-kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
}

[data-demo="marketing-bots"] .example-kpis li {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 50px;
    padding: 8px 16px;
    white-space: nowrap;
}

[data-demo="marketing-bots"] .example-kpis li.example-kpi-accent {
    background: var(--primary-text);
    color: var(--bg);
    border-color: var(--primary-text);
}

[data-demo="marketing-bots"] .example-sample-note {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 28px;
}

[data-demo="marketing-bots"] .example-frame {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
    text-align: left;
}

[data-demo="marketing-bots"] .example-frame-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 12px 18px;
}

[data-demo="marketing-bots"] .example-frame-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
}

[data-demo="marketing-bots"] .example-frame-dot:first-child { background: var(--primary); }
[data-demo="marketing-bots"] .example-frame-dot:nth-child(2) { background: var(--primary); }
[data-demo="marketing-bots"] .example-frame-dot:nth-child(3) { background: var(--primary); }

[data-demo="marketing-bots"] .example-frame-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text);
    margin-left: 8px;
    letter-spacing: 0.5px;
}

[data-demo="marketing-bots"] .example-frame-body {
    padding: 20px;
}

[data-demo="marketing-bots"] .example-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

[data-demo="marketing-bots"] .example-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
}

[data-demo="marketing-bots"] .example-play-btn {
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--primary-text);
    border: none;
    border-radius: 50px;
    padding: 10px 22px;
    cursor: pointer;
    align-self: flex-start;
}

[data-demo="marketing-bots"] .example-play-btn:hover {
    background: color-mix(in srgb, var(--primary-text) 82%, var(--bg));
}

[data-demo="marketing-bots"] .example-play-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

[data-demo="marketing-bots"] .example-chat {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 220px;
}

/* Runtime-injected chat messages (D3: global styles so JS-built DOM matches). */
[data-demo="marketing-bots"] .example-chat-msg {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 86%;
}

[data-demo="marketing-bots"] .example-chat-msg.example-chat-bot {
    align-self: flex-start;
    align-items: flex-start;
}

[data-demo="marketing-bots"] .example-chat-msg.example-chat-user {
    align-self: flex-end;
    align-items: flex-end;
}

[data-demo="marketing-bots"] .example-chat-avatar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--muted);
}

[data-demo="marketing-bots"] .example-chat-avatar svg {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex-shrink: 0;
}

[data-demo="marketing-bots"] .example-bubble {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 0.85rem;
    line-height: 1.5;
}

[data-demo="marketing-bots"] .example-bubble-bot {
    background: var(--surface);
    color: var(--text);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
}

[data-demo="marketing-bots"] .example-bubble-user {
    background: var(--primary-text);
    color: var(--bg);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
}

/* Filled lead card: old #ecfdf5/#065f46 pair → scoped ok pair (D7).
   Idle state replaces the old inline opacity:.4 start value. */
[data-demo="marketing-bots"] .example-lead-card {
    background: color-mix(in srgb, var(--demo-ok) 12%, var(--card));
    border: 1px solid color-mix(in srgb, var(--demo-ok) 35%, transparent);
    border-radius: 12px;
    padding: 14px;
    font-size: 0.82rem;
    color: var(--demo-ok);
    transition: opacity 0.3s ease;
}

[data-demo="marketing-bots"] .example-lead-card strong {
    display: block;
    margin-bottom: 4px;
}

[data-demo="marketing-bots"] .example-lead-card.is-idle {
    opacity: 0.4;
}

[data-demo="marketing-bots"] .example-lead-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.8rem;
}

[data-demo="marketing-bots"] .example-lead-list li {
    background: color-mix(in srgb, var(--card) 75%, transparent);
    border-radius: 8px;
    padding: 6px 10px;
}

[data-demo="marketing-bots"] .example-lead-list li strong {
    display: inline;
    margin: 0 4px 0 0;
}

@media (max-width: 768px) {
    [data-demo="marketing-bots"] h3.example-outcome { font-size: 1.5rem; }
    [data-demo="marketing-bots"] .example-frame-body { padding: 14px; }
    [data-demo="marketing-bots"] .example-two-col { grid-template-columns: 1fr; }
}
</style>

<script is:inline>
/* Port of the old marketing-chat replay IIFE, 1:1 message flow and timing,
   scoped to the demo root (D1/D4). RM: user-initiated replay only. */
(function () {
    try {
        var REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var root = document.querySelector('[data-demo="marketing-bots"]');
        if (!root) return;
        /* Avatars retokened per design: old #0e2a5c/#f542b3 fills → v2 vars. */
        var BOT_AV = '<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--primary-text)"/><rect x="9" y="12" width="14" height="10" rx="3" fill="var(--bg)"/><circle cx="13" cy="17" r="1.8" fill="var(--primary-text)"/><circle cx="19" cy="17" r="1.8" fill="var(--primary-text)"/><rect x="14" y="6" width="4" height="4" rx="1" fill="var(--bg)"/><line x1="8" y1="15" x2="5" y2="15" stroke="var(--bg)" stroke-width="1.6" stroke-linecap="round"/><line x1="24" y1="15" x2="27" y2="15" stroke="var(--bg)" stroke-width="1.6" stroke-linecap="round"/></svg>';
        var USER_AV = '<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--primary-text)"/><text x="16" y="21" text-anchor="middle" font-size="12" font-weight="800" fill="var(--bg)" font-family="Inter,sans-serif">A</text></svg>';
        var m = [
            ['user', 'Andrés Ríos', 'Buenos días, soy Andrés Ríos, de Distribuidora Andina. Se nos pierden las notificaciones de pagos de pedidos y queremos alertas por WhatsApp y correo.'],
            ['bot', 'Lamnda Bot', 'Mucho gusto, don Andrés, gracias por escribir a Lamnda. Entiendo que necesitan no perder pagos de pedidos con alertas por WhatsApp y correo, ¿cuántos pedidos y avisos manejan al día?'],
            ['user', 'Andrés Ríos', 'Manejamos unos doscientos pedidos al mes y unos ochenta avisos urgentes, casi todo por WhatsApp, algo por correo.'],
            ['bot', 'Lamnda Bot', 'Perfecto, para ese volumen le sirven nuestras Notificaciones Inteligentes: detectamos pago confirmado, pedido listo y factura vencida, y avisamos al instante.'],
            ['bot', 'Lamnda Bot', 'Salimos por WhatsApp, correo, Telegram, Slack y Outlook en menos de un minuto, en una semana queda listo, base desde ochocientos dólares según volumen.'],
            ['user', 'Andrés Ríos', 'Me interesa, agendemos. Mi teléfono es +57 310 245 6789 y mi correo es andres.rios@distribuidora-andina.com.'],
            ['bot', 'Lamnda Bot', 'Con gusto. Nuestra asesora Laura Gómez le ofrece veinte minutos el martes a las diez o el miércoles a las tres, ¿cuál prefiere?'],
            ['user', 'Andrés Ríos', 'El martes a las diez me sirve perfecto.'],
            ['bot', 'Lamnda Bot', 'Queda agendada su asesoría con Laura Gómez para el martes a las diez, veinte minutos por videollamada. Le enviaremos el enlace al correo.'],
            ['user', 'Andrés Ríos', 'Muchas gracias, quedo atento. Hasta el martes.']
        ];
        var b = root.querySelector('#chatPlay'), x = root.querySelector('#chatBox'), l = root.querySelector('#leadCard'), t = root.querySelector('#leadText');
        var i = 0, timer = null;
        function step() {
            if (i >= m.length) {
                b.textContent = 'Repetir';
                if (l) l.classList.remove('is-idle');
                t.innerHTML = '<li><strong>Nombre:</strong> Andrés Ríos</li><li><strong>Empresa:</strong> Distribuidora Andina</li><li><strong>Interés:</strong> Notificaciones Inteligentes (WhatsApp + correo)</li><li><strong>Fecha en que escribió:</strong> 2 de septiembre de 2026</li><li><strong>Correo electrónico:</strong> andres.rios@distribuidora-andina.com</li><li><strong>Fecha asesoría:</strong> Martes 10:00 a. m.</li>';
                i = 0; timer = null; return;
            }
            var who = m[i][0], name = m[i][1], text = m[i][2];
            var wrap = document.createElement('div');
            wrap.className = 'example-chat-msg ' + (who === 'bot' ? 'example-chat-bot' : 'example-chat-user');
            wrap.innerHTML = '<span class="example-chat-avatar">' + (who === 'bot' ? BOT_AV : USER_AV) + name + '</span>';
            var d = document.createElement('div');
            d.className = 'example-bubble ' + (who === 'bot' ? 'example-bubble-bot' : 'example-bubble-user');
            d.textContent = text;
            wrap.appendChild(d);
            x.appendChild(wrap);
            i++;
            timer = setTimeout(step, 800);
        }
        if (b) b.addEventListener('click', function () {
            x.innerHTML = '';
            if (l) l.classList.add('is-idle');
            t.innerHTML = '<li>Capturando lead…</li>';
            if (timer) clearTimeout(timer);
            i = 0;
            b.textContent = 'Reproduciendo…';
            step();
        });
    } catch (e) { if (window.console) console.warn('lamnda-demo', e); }
})();
</script>
